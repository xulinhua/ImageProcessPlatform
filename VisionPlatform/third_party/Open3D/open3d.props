<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Open3D 0.20 头文件、库、运行库在 VisionPlatform\third_party\Open3D。
    不读环境变量 OPEN3D_ROOT。别人拉仓库即可编 Open3d.* 算法插件。
  -->
  <PropertyGroup>
    <Open3DRoot>$(MSBuildThisFileDirectory)</Open3DRoot>
    <Open3DInc>$(Open3DRoot)include</Open3DInc>
    <Open3DInc3rd>$(Open3DRoot)include\open3d\3rdparty</Open3DInc3rd>
    <Open3DLib>$(Open3DRoot)lib</Open3DLib>
    <Open3DBin>$(Open3DRoot)bin</Open3DBin>
    <VisionHasOpen3D>false</VisionHasOpen3D>
    <VisionHasOpen3D Condition="Exists('$(Open3DInc)\open3d\Open3D.h') And Exists('$(Open3DLib)\Open3D.lib')">true</VisionHasOpen3D>
  </PropertyGroup>
  <PropertyGroup Condition="'$(VisionHasOpen3D)'=='true'">
    <IncludePath>$(Open3DInc);$(Open3DInc3rd);$(IncludePath)</IncludePath>
    <LibraryPath>$(Open3DLib);$(LibraryPath)</LibraryPath>
    <ExecutablePath>$(Open3DBin);$(ExecutablePath)</ExecutablePath>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(VisionHasOpen3D)'=='true'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(Open3DInc);$(Open3DInc3rd);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>VISION_HAS_OPEN3D=1;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(Open3DLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>Open3D.lib;tbb12.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>cmd /c if exist "$(Open3DBin)\*.dll" (copy /Y "$(Open3DBin)\*.dll" "$(SolutionDir)bin\$(Platform)\$(Configuration)\") &amp; exit /B 0</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
</Project>
