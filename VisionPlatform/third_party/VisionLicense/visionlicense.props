<?xml version="1.0" encoding="utf-8"?>
<!-- 许可已编进静态库。这里只把客户机申请程序拷到本工程输出目录。 -->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <VisionLicenseBin>$(MSBuildThisFileDirectory)bin\$(Platform)\$(Configuration)</VisionLicenseBin>
  </PropertyGroup>
  <Target Name="CopyVisionLicenseRuntime" AfterTargets="Build">
    <ItemGroup>
      <VisionLicenseRuntime Include="$(VisionLicenseBin)\Vision.LicenseRequest.exe" Condition="Exists('$(VisionLicenseBin)\Vision.LicenseRequest.exe')" />
      <VisionLicenseRuntime Include="$(VisionLicenseBin)\Vision.LicenseRequest.pdb" Condition="Exists('$(VisionLicenseBin)\Vision.LicenseRequest.pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(VisionLicenseRuntime)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
