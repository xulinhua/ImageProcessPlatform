<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutDir>$(SolutionDir)bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)obj\$(ProjectName)\$(Platform)\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <MinimalRebuild>false</MinimalRebuild>
      <DisableSpecificWarnings>4251;%(DisableSpecificWarnings)</DisableSpecificWarnings>
      <!-- Source charset: system ANSI (GBK on Chinese Windows). Runtime std::string text stays UTF-8 via qs/fromUtf8. -->
      <AdditionalIncludeDirectories>
        $(ProjectDir);
        $(SolutionDir)third_party\HsCommData\include;
        $(SolutionDir)include;
        $(SolutionDir)VisionCommon;
        $(SolutionDir)VisionCommon\common;
        $(SolutionDir)VisionToolBase;
        $(SolutionDir)VisionAlgToolBase;
        $(SolutionDir)Plugin.VisionHalCom;
        $(SolutionDir)VisionCommon\thread;
        $(SolutionDir)VisionCore;
        $(SolutionDir)VisionCore\model;
        $(SolutionDir)VisionCore\tool;
        $(SolutionDir)VisionCore\job;
        $(SolutionDir)VisionCore\station;
        $(SolutionDir)VisionCore\solution;
        $(SolutionDir)VisionCore\composite;
        $(SolutionDir)VisionCore\common;
        $(SolutionDir)VisionCore\comm;
        $(SolutionDir)VisionCore\device;
        $(SolutionDir)VisionComm;
        $(SolutionDir)VisionCalib;
        $(SolutionDir)VisionAuth;
        $(SolutionDir)VisionAuth\session;
        $(SolutionDir)VisionAuth\user;
        $(SolutionDir)VisionAuth\audit;
        $(SolutionDir)VisionLang;
        $(SolutionDir)VisionLang\language;
        $(SolutionDir)VisionLog;
        $(SolutionDir)VisionLog\log;
        $(SolutionDir)VisionDb;
        $(SolutionDir)VisionDb\db;
        $(SolutionDir)VisionFile;
        $(SolutionDir)VisionFile\file;
        $(SolutionDir)VisionPluginAPI;
        $(SolutionDir)VisionCfgMgr;
        $(SolutionDir)VisionCfgMgr\\store;
        $(SolutionDir)VisionWidgets;
        $(SolutionDir)VisionWidgets\theme;
        $(SolutionDir)VisionUi;
        $(SolutionDir)VisionUi\main;
        $(SolutionDir)VisionUi\workspace;
        $(SolutionDir)VisionUi\dialog;
        $(SolutionDir)VisionUi\runtime;
        $(SolutionDir)VisionToolUi;
        $(SolutionDir)VisionToolUi\editor;
        $(SolutionDir)VisionToolUi\debug;
        $(SolutionDir)VisionToolUi\register;
        $(SolutionDir)VisionAlgHal;
        $(SolutionDir)VisionGrabFile;
        $(SolutionDir)VisionGrabFile\grabber;
        $(SolutionDir)VisionGrabFile\camera;
        $(SolutionDir)third_party\stb;
        %(AdditionalIncludeDirectories)
      </AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(SolutionDir)third_party\HsCommData\lib\$(Platform)\$(Configuration);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>HsCommData.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <PostBuildEvent>
      <Command>cmd /c if exist "$(SolutionDir)third_party\HsCommData\bin\$(Platform)\$(Configuration)\HsCommData.dll" (copy /Y "$(SolutionDir)third_party\HsCommData\bin\$(Platform)\$(Configuration)\HsCommData.dll" "$(OutDir)HsCommData.dll") &amp; exit /B 0</Command>
    </PostBuildEvent>
  </ItemDefinitionGroup>
</Project>
