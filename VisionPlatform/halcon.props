<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Halcon 17.12 头文件、库、运行库在 VisionPlatform\third_party\Halcon。
    不探测本机 Program Files，也不读环境变量 HALCONROOT。
    本机安装只有 x64-win64 的导入库，Win32 目录未拷入。
  -->
  <PropertyGroup>
    <HalconRoot>$(MSBuildThisFileDirectory)third_party\Halcon</HalconRoot>
    <HALCONARCH Condition="'$(Platform)'=='Win32'">x86sse2-win32</HALCONARCH>
    <HALCONARCH Condition="'$(Platform)'!='Win32'">x64-win64</HALCONARCH>
    <HalconInc>$(HalconRoot)\include</HalconInc>
    <HalconIncCpp>$(HalconRoot)\include\halconcpp</HalconIncCpp>
    <HalconLib>$(HalconRoot)\lib\$(HALCONARCH)</HalconLib>
    <HalconBin>$(HalconRoot)\bin\$(HALCONARCH)</HalconBin>
    <VisionHasHalcon>false</VisionHasHalcon>
    <VisionHasHalcon Condition="Exists('$(HalconIncCpp)\HalconCpp.h') And Exists('$(HalconLib)\halconcpp.lib')">true</VisionHasHalcon>
  </PropertyGroup>
  <PropertyGroup>
    <IncludePath>$(HalconInc);$(HalconIncCpp);$(IncludePath)</IncludePath>
    <LibraryPath>$(HalconLib);$(LibraryPath)</LibraryPath>
    <ExecutablePath>$(HalconBin);$(ExecutablePath)</ExecutablePath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(HalconInc);$(HalconIncCpp);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>HAVE_HALCON;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(HalconLib);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>halcon.lib;halconcpp.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
  </ItemDefinitionGroup>
</Project>
