#ifndef VISION_LOGINDIALOG_H
#define VISION_LOGINDIALOG_H

#include <QDialog>
#include <QString>

class QLineEdit;
class QLabel;

namespace Vision {

class Session;

/**
 * @class LoginDialog
 * @brief 用户登录。口令可为空
 */
class LoginDialog : public QDialog {
    Q_OBJECT
public:
    /**
     * @brief 构造登录对话框，预填上次登录名
     * @param session 会话（不拥有）
     */
    explicit LoginDialog(Session* session, QWidget* parent = 0);
    /** @brief 输入框中的登录名（去空白） */
    QString loginName() const;

private slots:
    /** @brief 尝试登录；失败累计次数并显示错误 */
    void onOk();

private:
    Session* m_session;  ///< 会话（不拥有）
    QLineEdit* m_user;  ///< 登录名
    QLineEdit* m_pwd;   ///< 口令
    QLabel* m_err;      ///< 错误提示
    int m_fails;        ///< 连续失败次数
};

}

#endif
